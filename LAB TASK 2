@dataclass
class Receiver:
    id: int
    priority: int
    name: str
    organ: str
    bloodGroup: str


receiverQ = deque()
receiverPQ = []


def addReceiver():
    receiver_id = read_int("Enter receiver id: ")
    name = read_text("Enter name: ")
    organ = read_text("Enter organ: ")

    blood_group = choose_from_list(bloodGroups, "Select blood group:")
    priority = read_int("Enter priority (higher=more urgent): ")

    receiver = Receiver(receiver_id, priority, name, organ, blood_group)

    receiverQ.append(receiver)
    heapq.heappush(receiverPQ, (-priority, receiver_id, receiver))

    print("Receiver added!")


def printReceivers():
    print("Receivers (FIFO):")

    for receiver in receiverQ:
        print(
            f"{receiver.id}: {receiver.name}, Organ: {receiver.organ}, "
            f"Blood Group: {receiver.bloodGroup}, Priority: {receiver.priority}"
        )


def printReceiversByPriority():
    print("Receivers (by priority):")

    heap = list(receiverPQ)
    heapq.heapify(heap)

    while heap:
        _, _, receiver = heapq.heappop(heap)
        print(
            f"{receiver.id}: {receiver.name}, Organ: {receiver.organ}, "
            f"Blood Group: {receiver.bloodGroup}, Priority: {receiver.priority}"
        )


