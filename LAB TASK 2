def isCompatible(donor_bg, receiver_bg):
    if donor_bg == receiver_bg:
        return True

    if donor_bg in ("O-", "O+"):
        return True

    if receiver_bg in ("AB+", "AB-"):
        return True

    return False


def collectDonors(node, result):
    if not node:
        return

    result.append(node)
    collectDonors(node.left, result)
    collectDonors(node.right)


def matchDonorsWithReceivers():
    donors = []
    collectDonors(donorRoot, donors)

    print("\n--- Donor-Receiver Matches ---")

    for donor in donors:
        if not donor.canDonate:
            continue

        for receiver in receiverQ:
            if donor.organ == receiver.organ and isCompatible(donor.bloodGroup, receiver.bloodGroup):
                print(
                    f"Donor {donor.name} "
                    f"({donor.organ}, {donor.bloodGroup}) "
                    f"matches with Receiver {receiver.name} "
                    f"({receiver.organ}, {receiver.bloodGroup})"
                )

    print("--- End Matches ---")


