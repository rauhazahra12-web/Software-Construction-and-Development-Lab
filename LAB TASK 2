def insertLog(node, log_id, details):
    if node is None:
        return Log(log_id, details)

    if log_id < node.id:
        node.left = insertLog(node.left, log_id, details)
    elif log_id > node.id:
        node.right = insertLog(node.right, log_id, details)

    return node


