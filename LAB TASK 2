# Donor AVL Tree
# =========================

@dataclass
class Donor:
    id: int
    name: str
    organ: str
    bloodGroup: str
    healthCondition: str
    canDonate: bool
    left: object = None
    right: object = None
    height: int = 1


donorRoot = None

bloodGroups = ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]

healthConditions = [
    "Healthy", "Diabetic", "Hepatitis B Carrier",
    "Hepatitis C Carrier", "Hypertensive", "Cancer Survivor",
    "Asthmatic", "Heart Disease", "Kidney Disease", "Liver Disease"
]


def height(node):
    return node.height if node else 0


def balance(node):
    return height(node.left) - height(node.right) if node else 0


def rightRotate(y):
    x = y.left
    t2 = x.right

    x.right = y
    y.left = t2

    y.height = max(height(y.left), height(y.right)) + 1
    x.height = max(height(x.left), height(x.right)) + 1

    return x


def leftRotate(x):
    y = x.right
    t2 = y.left

    y.left = x
    x.right = t2

    x.height = max(height(x.left), height(x.right)) + 1
    y.height = max(height(y.left), height(y.right)) + 1

    return y


def insertDonor(node, donor_id, name, organ, blood_group, health_condition, can_donate):
    if node is None:
        return Donor(donor_id, name, organ, blood_group, health_condition, can_donate)

    if donor_id < node.id:
        node.left = insertDonor(node.left, donor_id, name, organ, blood_group, health_condition, can_donate)
    elif donor_id > node.id:
        node.right = insertDonor(node.right, donor_id, name, organ, blood_group, health_condition, can_donate)
    else:
        return node

    node.height = 1 + max(height(node.left), height(node.right))
    balance_value = balance(node)

    if balance_value > 1 and donor_id < node.left.id:
        return rightRotate(node)

    if balance_value < -1 and donor_id > node.right.id:
        return leftRotate(node)

    if balance_value > 1 and donor_id > node.left.id:
        node.left = leftRotate(node.left)
        return rightRotate(node)

    if balance_value < -1 and donor_id < node.right.id:
        node.right = rightRotate(node.right)
        return leftRotate(node)

    return node


def isHealthEligible(health_condition, organ):
    del organ
    return health_condition not in NOT_ELIGIBLE_DONOR_CONDITIONS


def isOrganFresh(organ, hours_since_death):
    max_hours = ORGAN_FRESHNESS_RULES.get(organ, 6)
    return hours_since_death <= max_hours


def addDonor():
    global donorRoot

    donor_id = read_int("Enter donor id: ")
    name = read_text("Enter name: ")
    organ = read_text("Enter organ: ")

    blood_group = choose_from_list(bloodGroups, "Select blood group:")
    health_condition = choose_from_list(healthConditions, "Select health condition:")

    is_deceased = read_int("Is the donor deceased? (1=Yes, 0=No): ", minimum=0, maximum=1)
    can_donate = True

    if not isHealthEligible(health_condition, organ):
        print("Donor is NOT eligible to donate due to health condition:", health_condition)
        can_donate = False

    if is_deceased:
        hours_since_death = read_int("How many hours since death? ")

        if not isOrganFresh(organ, hours_since_death):
            print(f"Organ is NOT fresh enough for donation ({hours_since_death} hours since death).")
            can_donate = False
        else:
            print("Organ is fresh and can be considered for donation.")

    donorRoot = insertDonor(donorRoot, donor_id, name, organ, blood_group, health_condition, can_donate)
    print("Donor added!")

    if can_donate:
        days_until_operation = read_int("How many days until operation? ")
        print(f"Operation scheduled in {days_until_operation} day(s).")


