# =========================
# AVL Delete / Search
# =========================

def minValueNode(node):
    current = node

    while current and current.left:
        current = current.left

    return current


def deleteDonor(root, donor_id):
    if not root:
        return root

    if donor_id < root.id:
        root.left = deleteDonor(root.left, donor_id)
    elif donor_id > root.id:
        root.right = deleteDonor(root.right, donor_id)
    else:
        if not root.left:
            return root.right

        if not root.right:
            return root.left

        temp = minValueNode(root.right)

        root.id = temp.id
        root.name = temp.name
        root.organ = temp.organ
        root.bloodGroup = temp.bloodGroup
        root.healthCondition = temp.healthCondition
        root.canDonate = temp.canDonate

        root.right = deleteDonor(root.right, temp.id)

    root.height = 1 + max(height(root.left), height(root.right))
    balance_value = balance(root)

    if balance_value > 1 and balance(root.left) >= 0:
        return rightRotate(root)

    if balance_value > 1 and balance(root.left) < 0:
        root.left = leftRotate(root.left)
        return rightRotate(root)

    if balance_value < -1 and balance(root.right) <= 0:
        return leftRotate(root)

    if balance_value < -1 and balance(root.right) > 0:
        root.right = rightRotate(root.right)
        return leftRotate(root)

    return root


def searchDonor(node, donor_id):
    if not node:
        return None

    if node.id == donor_id:
        return node

    if donor_id < node.id:
        return searchDonor(node.left, donor_id)

    return searchDonor(node.right, donor_id)


def avlHeight(node):
    return height(node)


def countEligibleDonors(node):
    if not node:
        return 0

    return (1 if node.canDonate else 0) + countEligibleDonors(node.left) + countEligibleDonors(node.right)


def countDonorsByOrgan(node, organ):
    if not node:
        return 0

    return (1 if node.organ == organ else 0) + countDonorsByOrgan(node.left, organ) + countDonorsByOrgan(node.right, organ)


